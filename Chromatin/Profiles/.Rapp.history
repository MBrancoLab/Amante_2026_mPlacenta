library(tidyverse)#
library(gplots)#
##read data#
#
trend_files = list.files('Trends', full.names=TRUE)#
#
data = tibble()#
for (f in trend_files) {#
	sub = read_tsv(f, skip=2, col_names=c('sample','ignore',1:100)) %>%#
		select(!ignore) %>%#
		pivot_longer(cols=!sample,names_to='bin') %>%#
		mutate(across(bin, as.integer)) %>%#
		add_column(te = gsub('_trend.txt','',basename(f)))#
	data = rbind(data, sub)#
}#
##plot trends#
#
plot_trend = function(data, te, samples, ymax=max(data$value)) {#
	filter(data, te==te, sample %in% samples) %>%#
	ggplot(aes(x=bin, y=value, colour=sample)) +#
		geom_line(linewidth=1) +#
		ylim(0, ymax) +#
		theme_classic() +#
		ylab('Mean RPM') +#
		scale_x_continuous(name='', breaks=c(0,20,80,100), labels=c('-2kb','start','end','+2kb'))#
}#
##plots#
#
plot_trend(data, te ='L1MdTf_I',#
	samples=c('H3K4me3_bTSCs_musculus',#
			'H3K4me3_GFPTSCs_musculus',#
			'H3K4me3_placenta_musculus'))
data
t=filter(data, te='L1MdTf_I')
