library(GenomicRanges)#
library(tidyverse)#
##functions#
#
read.bed = function(bed.file) {#
	bed = read_tsv(bed.file, col_names=FALSE)#
	gr = GRanges(seqnames=bed$X1, IRanges(start=bed$X2, end=bed$X3))#
	return(gr)#
}#
#
get.overlaps = function(bed.list, ref) {#
	overlaps = lapply(bed.list, function(bed) GenomicRanges::intersect(bed.list[[ref]], bed))#
	return(unlist(lapply(overlaps, function(x) sum(lengths(x)))))#
}#
##read peaks#
#
me1.files = c(list.files('musculus_cuttag', pattern='H3K4me1', full.names=TRUE),#
			list.files('musculus_encode', pattern='H3K4me1', full.names=TRUE))#
#
me3.files = c(list.files('musculus_cuttag', pattern='H3K4me3', full.names=TRUE),#
			list.files('musculus_encode', pattern='H3K4me3', full.names=TRUE))#
#
ac.files = c(list.files('musculus_cuttag', pattern='H3K27ac', full.names=TRUE),#
			list.files('musculus_encode', pattern='H3K27ac', full.names=TRUE))#
#
me1 = me3 = ac = list()#
for (i in 1:length(me1.files)) {#
	me1[[i]] = read.bed(me1.files[i])#
	me3[[i]] = read.bed(me3.files[i])#
	if (i <= length(ac.files)) ac[[i]] = read.bed(ac.files[i])#
}#
names(me1) = me1.files#
names(me3) = me3.files#
names(ac) = ac.files
me1.files
length(me1)
length(me3)
