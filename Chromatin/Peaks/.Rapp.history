me1.files
?list
unique.peaks = function(bed.files) {	#
	#read peak files#
	bed = list()#
	for (i in 1:length(bed.files)) {#
		bed[[i]] = read.bed(bed.files[i])#
	}#
	names(bed) = sub('.bed.gz', '', basename(bed.files))#
	#get tissue-specific peaks#
	sp.peaks = list()	#
	for (i in 1:length(bed)) {#
		ref = bed[[i]]#
		others = bed[-i]#
		for (j in 1:length(others)) {#
			ref = subsetByOverlaps(ref, others[[j]], invert=TRUE)#
		}#
		sp.peaks[[i]] = ref#
	}#
	names(sp.peaks) = names(bed)#
	return(sp.peaks)#
}
