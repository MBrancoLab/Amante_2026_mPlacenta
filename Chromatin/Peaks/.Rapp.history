			tissue = substr(bname,regexpr('_',bname)+1,regexpr('\\.',bname)-1),#
			source = sub('musculus_','',dirname(names(all.ov))),#
			plength = all.ov,#
			ts = factor(paste(tissue, source), levels = ts.order))
ov
