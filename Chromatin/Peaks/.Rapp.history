cor_matrix = function(counts) {#
	nc = ncol(counts)#
	m = matrix(nrow=nc-12, ncol=nc-12)#
	colnames(m) = rownames(m) = colnames(counts)[13:nc]#
	for (i in 13:nc) {#
		for (j in 13:nc) {#
			m[i-12,j-12] = cor.test(counts[,i],counts[,j])$estimate#
		}#
	}#
	return(m)#
}#
#
plot_cor = function(cor.matrix, min=0, max=1) {#
	heatmap.2(cor.matrix, scale='none',#
		col = cm.colors(60),#
		breaks = seq(min,max,length.out=61),#
		margins = c(8,8), cexRow=0.7, cexCol=0.7,#
		trace = 'none', density.info='none')#
}#
#
plot_plac = function(counts, mod) {#
	x = paste(mod, 'placenta_encode', sep='_')#
	y = paste(mod, 'placenta_musculus', sep='_')#
	ggplot(data=counts, aes(x=get(x),y=get(y))) +#
		geom_pointdensity(size=0.5, show.legend=F) +#
		scale_color_viridis() +#
		theme_classic() +#
		xlab('ENCODE (log2 reads)') +#
		ylab('This study (log2 reads)')#
}
ac.cor = cor_matrix(ac)
plot_cor(ac.cor, min=0.3, max=0.8)
