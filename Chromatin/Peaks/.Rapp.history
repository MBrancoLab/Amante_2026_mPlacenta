##functions#
#
read.bed = function(bed.file) {#
	bed = read_tsv(bed.file, col_names=FALSE)#
	gr = GRanges(seqnames=bed$X1, IRanges(start=bed$X2, end=bed$X3))#
	return(gr)#
}#
#
get.overlaps = function(bed.list, ref) {#
	overlaps = lapply(bed.list, function(bed) GenomicRanges::intersect(bed.list[[ref]], bed))#
	return(unlist(lapply(overlaps, function(x) sum(lengths(x)))))#
}#
