	geom_bar(stat='identity', position=position_dodge()) +#
	theme_classic() +#
	xlab('') +#
	ylab('observed/expected') +#
	geom_hline(yintercept=1, linetype='dashed')
mm = filter(over, type=='nonOrthologous', species=='mm')#
