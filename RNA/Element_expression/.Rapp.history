library(Seurat)#
library(dplyr)#
library(tidyr)#
library(gplots)#
##Read data from cellranger#
#
plac.data = Read10X('filtered_feature_bc_matrix')#
##Make and filter Seurat object#
#
plac = CreateSeuratObject(plac.data, min.cells=3, min.features=200)#
#
VlnPlot(plac, features = c("nFeature_RNA", "nCount_RNA"), ncol = 2)#
plac = subset(plac, subset = nFeature_RNA > 200 & nFeature_RNA < 2000)#
##Process#
#
plac = NormalizeData(plac) #
plac = FindVariableFeatures(plac, selection.method = "vst", nfeatures = 2000)#
plac = ScaleData(plac)#
plac = RunPCA(plac)#
ElbowPlot(plac, ndims=30)#
#
plac = FindNeighbors(plac, dims = 1:20)#
plac = FindClusters(plac, resolution = 0.5)#
##Remove minor clusters#
#
ncells = table(Idents(plac))#
plac = subset(plac, idents = names(ncells)[ncells>50])
VlnPlot(plac, features = c('Syna','Glis1','Stra6'), pt.size=0.5) #SynTI
VlnPlot(plac, features = c('Rab3gap2','Cdk5rap1','Suv39h2'), pt.size=0.5) #SynTI
new.cluster.ids = c("SynTI", "Glycogen cells", "SpT", "S-TGC", "Endothelial",#
	"SynTII", "Pericytes", "Mesenchymal I", "Mesenchymal II", "Decidua")#
names(new.cluster.ids) = levels(plac)#
plac = RenameIdents(plac, new.cluster.ids)
VlnPlot(plac, features = c('Rab3gap2','Cdk5rap1','Suv39h2'), pt.size=0.5) #SynTI
VlnPlot(plac, features = c('Gm13391','Gm36888','Noct'), pt.size=0.5) #SynTI
VlnPlot(plac, features = c('5830444B04Rik','Stx18','Hikeshi'), pt.size=0.5) #SynTI
VlnPlot(plac, features = c('Bckdhb','Qrsl1','Acly'), pt.size=0.5) #SynTI
VlnPlot(plac, features = c('2610035D17Rik','Gm30198','Atg2b'), pt.size=0.5) #SynTI
VlnPlot(plac, features = c('Gm48544','Zfp229','4930481A15Rik'), pt.size=0.5) #SynTI
chim = scan('~/Downloads/iap_chimeras.txt',character())
idents = Idents(plac)#
iap = as_tibble(as.matrix(plac[['RNA']]$counts), rownames='gene') %>%#
	filter(gene %in% chim) %>%#
	pivot_longer(cols=!gene, names_to='barcode', values_to='expr') %>%#
	mutate(cluster = idents[match(barcode, names(idents))])#
#
iap.sum = group_by(iap, gene, cluster) %>%#
	summarise(perc_cells=sum(expr>1)/length(expr)*100) %>%#
	pivot_wider(names_from=cluster, values_from=perc_cells)#
#
iap.mat = as.matrix(iap.sum[,-1])#
rownames(iap.mat) = iap.sum$gene#
#
c.order = c("SpT", "Glycogen cells", "S-TGC", "SynTI", "SynTII",#
	"Endothelial", "Pericytes", "Mesenchymal I", "Mesenchymal II", "Decidua")
head(iap.mat)
heatmap.2(iap.mat[order(rowMeans(iap.mat), decreasing=TRUE),c.order],#
	scale='none',#
	Rowv=FALSE, Colv=FALSE,#
	dendrogram='none',#
	col=hcl.colors(100),#
	trace='none',#
	density.info='none',#
	margins=c(11,9))
?heatmap.2
heatmap.2(iap.mat[order(rowMeans(iap.mat), decreasing=TRUE),c.order],#
	scale='row',#
	Rowv=FALSE, Colv=FALSE,#
	dendrogram='none',#
	col=hcl.colors(100),#
	trace='none',#
	density.info='none',#
	margins=c(11,9))
