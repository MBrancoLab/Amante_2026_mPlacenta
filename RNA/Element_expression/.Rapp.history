			up = placenta-GFPTSCs_musculus.bam>1 & placenta-bTSCs_musculus.bam>1,#
			down = GFPTSCs_musculus.bam-placenta>1 & bTSCs_musculus.bam-placenta>1)#
##plot heatmap#
#
