cs
cs = read_tsv('cybersort.txt')
cs
cs.av = group_by(cs, tissue, celltype) %>% summarise(av.frac = mean(fraction))
cs.av
ggplot(cs.av, aes(x=celltype, y=av.frac)) +#
	geom_bar(stat='identity')
ggplot(cs.av, aes(x=celltype, y=av.frac, fill=tissue)) +#
	geom_bar(stat='identity')
ggplot(cs.av, aes(x=tissue, y=av.frac, fill=celltype)) +#
	geom_bar(stat='identity')
cs = read_tsv('cybersort.txt')#
##get means#
#
cs.av = group_by(cs, tissue, celltype) %>% summarise(av.frac = mean(fraction))#
##plot#
#
filter(cs.av, tissue!='TSCs') %>%#
ggplot(aes(x=tissue, y=av.frac, fill=celltype)) +#
	geom_bar(stat='identity')
filter(cs.av, tissue!='TSCs') %>%#
ggplot(aes(x=tissue, y=av.frac, fill=celltype)) +#
	geom_bar(stat='identity') +#
	xlab('') +#
	ylab('') +#
	theme_classic()
