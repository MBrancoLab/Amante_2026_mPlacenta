pivot_longer(subf.count, cols=!Feature, names_to='type', values_to='counts') %>%#
ggplot(aes(x=Feature, y=counts, fill=factor(type, levels=c('exp','up','down')))) +#
	geom_bar(stat='identity', position=position_dodge()) +#
	theme_classic() +#
	xlab('') +#
	ylab('% of elements')
pivot_longer(subf.count, cols=!Feature, names_to='type', values_to='counts') %>%#
