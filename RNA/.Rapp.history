rel.plot = function(sample1, sample2) {#
	quartz(w=4.5,h=3)#
	filter(as.data.frame(tss), !is.na(distance)) %>%#
	ggplot(aes(x=nearest, y=get(sample2)-get(sample1), fill=dgroup)) +#
		geom_boxplot(outlier.colour=NA) +#
		theme_classic() +#
		ylim(-5,5) +#
		scale_fill_manual(values=colorRampPalette(c('lightblue','darkblue'))(4)) +#
		geom_hline(yintercept=0, linetype='dashed')#
}#
#
rel.plot('placenta','GFPTSC')
tss$dgroup = cut(tss$distance, c(5e4,1e9), include.lowest=T)#
##plot relative expression as a function of distance#
