library(svglite)
ggsave('~/Downloads/subf.svg')
heatmap.2(iap.mat, trace='none', scale='none',#
	col=hcl.colors(100))
iap
filter(iap, expr,up) %>% arrange(placenta)
?arrange
filter(iap, expr,up) %>% arrange(desc(placenta))
head(as.data.frame(filter(iap, expr,up) %>% arrange(desc(placenta))))
head(as.data.frame(filter(iap, expr,up,Probe=='IAPEY4_LTR') %>% arrange(desc(placenta))))
rltr4 = read_tsv('RLTR4_intergenic_RPM.txt')#
rltr4$placenta = rowMeans(select(rltr4, starts_with('Placenta')))
rltr4
rltr4 = mutate(rltr4, expr = placenta>-3 | GFPTSCs_musculus.bam>-3 | bTSCs_musculus.bam>-3,#
			up = placenta-GFPTSCs_musculus.bam>1 & placenta-bTSCs_musculus.bam>1,#
			down = GFPTSCs_musculus.bam-placenta>1 & bTSCs_musculus.bam-placenta>1)
rltr4.mat = as.matrix(filter(rltr4, expr) %>% select(ends_with('bam')))
rltr4.mat = as.matrix(filter(rltr4, expr) %>% select(ends_with('bam')))#
#
heatmap.2(rltr4.mat, trace='none', scale='none',#
	col=hcl.colors(100))
head(as.data.frame(filter(rltr4, expr) %>% arrange(desc(placenta))))
rltr4 = read_tsv('RLTR4_intergenic_RPM.txt')#
rltr4$placenta = rowMeans(select(rltr4, starts_with('Placenta')))#
#
rltr4 = mutate(rltr4, expr = placenta>-3 | GFPTSCs_musculus.bam>-3 | bTSCs_musculus.bam>-3)#
rltr4.mat = as.matrix(filter(rltr4, expr) %>% select(ends_with('bam')))#
#
heatmap.2(rltr4.mat, trace='none', scale='none',#
	col=hcl.colors(100))
head(as.data.frame(filter(rltr4, expr) %>% arrange(desc(placenta))))
