library(tidyverse)#
library(ggtranscript)#
#gtf file#
#
gtf = read_tsv('Suv39h2_isoforms.gtf', col_names=FALSE)#
#
##parse#
#
split.att = strsplit(gtf$X9, split='[;\"]')#
get.att = function(att) {#
	unlist(lapply(split.att, function(x) {#
			pos = grep(att, x)#
			if (length(pos)>0) {#
				return(x[pos + 1])#
			} else {#
				return('')#
			}#
		}))#
}#
#
suv = tibble(seqnames=gtf$X1,#
			start=gtf$X4,#
			end=gtf$X5,#
			strand=gtf$X7,#
			type=gtf$X3,#
			gene_name=get.att('^gene_id'),#
			transcript_name=get.att('transcript_id'))#
##plot#
#
suv.exons = filter(suv, type=='exon')#
#
ggplot(suv.exons, aes(xstart=start, xend=end, y=transcript_name)) +#
    geom_range() +#
    geom_intron(data=to_intron(suv.exons,'transcript_name'), aes(strand=strand)) +#
    theme_classic()
library(tidyverse)#
##stringtie quantification data#
#
q.files = list.files('merged_quant', full.names=TRUE)#
#
quant = tibble()#
for (f in q.files) {#
	sub = read_tsv(f) %>%#
		add_column(sample = gsub('_quant.ctab.gz','',basename(f)))%>%#
		mutate(tissue = gsub('-[[:digit:]]','',sample))#
	quant = rbind(quant,sub)#
}#
##add info on which isoforms from selected genes have IAP TSS#
##calculate percentage of IAP TSS usage#
#
meta = read_tsv('iap_chimera_isoforms.txt')#
#
iap = filter(quant, t_name %in% meta$t_name) %>%#
	mutate(te_tss = meta$te_tss[match(t_name, meta$t_name)],#
			gene = meta$gene_name[match(t_name, meta$t_name)]) %>%#
	group_by(gene, sample, tissue) %>%#
	summarise(perc = sum(FPKM[te_tss])/sum(FPKM)*100)#
iap$perc[iap$perc=='NaN'] = 0#
##plot IAP isoform usage#
#
group_by(iap, gene, tissue) %>% summarise(mean_perc=mean(perc)) %>%#
ggplot(aes(x=gene, y=tissue)) +#
	geom_point(aes(size=mean_perc), stroke=0, col='navy') +#
	theme_classic() +#
	scale_x_discrete(guide=guide_axis(angle=90)) +#
	scale_size_continuous(range=c(0,5)) +#
	xlab('') +#
	ylab('')
library(tidyverse)
tx.files = list.files(pattern='chimTx.txt')#
#
tx = tibble()#
for (f in tx.files) {#
	sub = read_tsv(f, col_names=c('te.chr','te.start','te.end','te.name','te.sw','te.strand',#
								'tx.chr','tx.start','tx.end','tx.name','tx.fpkm','tx.strand')) %>%#
		mutate(te.id = paste(te.chr,te.start,te.name,sep='_')) %>%#
		add_column(sample = gsub('-chimTx.txt','',f))#
	tx = rbind(tx,sub)#
}#
##select consistent TEs in placenta#
#
p1.tes = tx$te.id[tx$sample=='Placenta_musculus-1']#
p2.tes = tx$te.id[tx$sample=='Placenta_musculus-2']#
p3.tes = tx$te.id[tx$sample=='Placenta_musculus-3']#
plac.tes = p1.tes[p1.tes %in% p2.tes & p1.tes %in% p3.tes]#
#
plac.tx = filter(tx, te.id %in% plac.tes)#
group_by(plac.tx, sample) %>% summarise(n.te=length(unique(te.id)))
gfp.tes = tx$te.id[tx$sample=='GFPTSCs_musculus']#
b6.tes = tx$te.id[tx$sample=='bTSCs_musculus']#
#
pspec = filter(plac.tx, !(te.id %in% gfp.tes) & !(te.id %in% b6.tes),#
			sample=='Placenta_musculus-1')#
group_by(pspec, te.name) %>% summarise(n=length(te.name))
filter(tx,grepl('IAP',te.name)) %>%#
	group_by(sample) %>%#
	summarise(n.te=length(unique(te.id)))#
#
iap.tx = filter(plac.tx, grepl('IAP',te.name))#
group_by(iap.tx, sample) %>% summarise(n.te=length(unique(te.id)))
l1.tx = filter(plac.tx, grepl('L1Md',te.name), te.end-te.start>5000)#
group_by(l1.tx, sample) %>% summarise(n.te=length(unique(te.id)))
write_tsv(rbind(iap.tx, l1.tx), 'iap_l1_transcripts.txt')
