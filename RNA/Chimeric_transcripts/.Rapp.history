plot.means = function(data, genes) {#
	sub = tibble(data[rownames(data) %in% genes,]) %>%#
		add_column(gene = rownames(data)[rownames(data) %in% genes]) %>%#
		pivot_longer(cols=colnames(data)) %>%#
		mutate(cluster = clusters$cluster[match(name, rownames(clusters))])#
	c.order = c("SpT", "Glycogen cells", "S-TGC", "SynTI", "SynTII",#
	"Endothelial", "Pericytes", "Mesenchymal I", "Mesenchymal II", "Decidua")#
	group_by(sub, gene, cluster) %>% summarise(av_expr=mean(value)) %>%#
	ggplot(aes(x=factor(gene,levels=genes), y=factor(cluster,levels=c.order))) +#
		geom_point(aes(size=av_expr, colour=av_expr), stroke=0) +#
		scale_size_continuous(range = c(0.5,7)) +#
		scale_colour_gradient(low='grey', high='red') +#
		theme_classic() +#
		theme(axis.text.x = element_text(angle = 45, hjust=1)) +#
		xlab('') +#
		ylab('')#
}#
