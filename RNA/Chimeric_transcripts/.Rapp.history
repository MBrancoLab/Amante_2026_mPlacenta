		add_column(sample = gsub('-chimTx.txt','',f))#
	tx = rbind(tx,sub)#
}
plac.tes = tx$te.id[grep('Placenta_musculus', tx$sample)]
head(plac.tes)
te.freq = table(plac.tes)
te.freq(grep('L1Md',names(te.freq)))
te.freq[grep('L1Md',names(te.freq))]
