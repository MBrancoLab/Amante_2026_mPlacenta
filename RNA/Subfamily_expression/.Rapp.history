library(tidyverse)#
library(patchwork)#
##read squire files#
#
sq.files = list.files(pattern='subFcounts.txt')#
#
squire = tibble()#
for (f in sq.files) {#
	sub = read_tsv(f) %>% mutate(tissue=gsub('_musculus[[:print:]]+','',Sample))#
	squire = rbind(squire, sub)#
}#
##read TEtranscripts files#
#
te.files = list.files(pattern='TEtranscripts.cntTable')#
#
tetr = tibble()#
for (f in te.files) {#
	sub = read_tsv(f, col_names=c('roi','count'), skip=1) %>%#
		mutate(rpm=count/sum(count)*1e6, tissue=gsub('_musculus[[:print:]]+','',f)) %>%#
		add_column(sample=gsub('_1_TEtranscripts.cntTable','',f))#
	tetr = rbind(tetr, sub)#
}
plot.te = function(te) {#
	p1 = squire %>% filter(`Subfamily:Family:Class`==te) %>%#
	ggplot(aes(x=tissue, y=fpkm)) +#
		geom_bar(stat='summary', fun=mean) +#
		geom_point(position=position_jitter(0.1)) +#
		theme_classic() +#
		xlab('') +#
		ylab('FPKM') +#
		ggtitle('SQuIRE')#
	p2 = tetr %>% filter(roi==te) %>%#
	ggplot(aes(x=tissue, y=rpm)) +#
		geom_bar(stat='summary', fun=mean) +#
		geom_point(position=position_jitter(0.1)) +#
		theme_classic() +#
		xlab('') +#
		ylab('RPM') +#
		ggtitle('TEtranscripts')#
	p1 + p2#
}#
#
plot.te('IAPEz-int:ERVK:LTR')
plot.te('IAPLTR1_Mm:ERVK:LTR')
plot.te('L1Md_T:L1:LINE')
plot.te('RLTR4_Mm:ERV1:LTR')
tetr = tibble()#
for (f in te.files) {#
	sub = read_tsv(f, col_names=c('roi','count'), skip=1) %>%#
		mutate(rpm=count/sum(count)*1e6, tissue=gsub('_musculus[[:print:]]+','',f)) %>%#
		add_column(sample=gsub('_TEtranscripts.cntTable','',f))#
	tetr = rbind(tetr, sub)#
}
