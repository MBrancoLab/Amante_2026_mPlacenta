plot.te = function(te) {#
	quartz(w=3.5,h=4)#
	subf %>% filter(`Subfamily:Family:Class`==te) %>%#
	ggplot(aes(x=tissue, y=fpkm)) +#
		geom_bar(stat='summary', fun=mean) +#
		geom_point(position=position_jitter(0.1)) +#
		theme_classic() +#
		xlab('') +#
		ylab('FPKM') +#
		ggtitle(te)#
}#
#
plot.te('Ricksha_c:MULE-MuDR:DNA')
