library(pzfx)
library(tidyverse)
df=read_pzfx('20240829_Suv39h2.prism')
suv = read_tsv('Suv39h2_qPCR')
suv = read_tsv('Suv39h2_qPCR.txt')
suv
ggplot(suv, aes(x=Isoform, y=Expression, fill=Sample)) +#
	geom_bar(stat='summary', fun=mean, col='black', fill='lightblue', width=0.6)
ggplot(suv, aes(x=Isoform, y=Expression, colour=Sample)) +#
	geom_bar(stat='summary', fun=mean, col='black', fill='lightblue', width=0.6)
ggplot(suv, aes(x=Isoform, y=Expression, colour=Sample)) +#
	geom_bar(stat='summary', fun=mean, col='black', fill='lightblue', width=0.6) +#
	geom_point(position=position_jitter(0.1))
ggplot(suv, aes(x=Isoform, y=Expression, colour=Sample)) +#
	geom_bar(position=position_dodge(), stat='summary', fun=mean, col='black', fill='lightblue', width=0.6)
ggplot(suv, aes(x=Isoform, y=Expression, fill=Sample)) +#
	geom_bar(position=position_dodge(), stat='summary', fun=mean, col='black', fill='lightblue', width=0.6)
ggplot(suv, aes(x=Isoform, y=Expression, fill=Sample)) +#
	geom_bar(position=position_dodge(), stat='summary', fun=mean, col='black', width=0.6)
ggplot(suv, aes(x=Isoform, y=Expression, fill=Sample)) +#
	geom_bar(position=position_dodge(), stat='summary', fun=mean, col='black', width=0.6) +#
	geom_point(position=position_jitterdodge(jitter.width=0.1, dodge.width=0.6), col='black') +#
	xlab('') +#
	ylab('Relative expression') +#
	theme_classic()
ggplot(suv, aes(x=Isoform, y=Expression, fill=Sample)) +#
	geom_bar(position=position_dodge(), stat='summary', fun=mean, col='black', width=0.6) +#
	geom_point(position=position_dodge(width=0.6), col='black') +#
	xlab('') +#
	ylab('Relative expression') +#
	theme_classic()
library(svglite)
ggsave('~/Downloads/suv.svg')
