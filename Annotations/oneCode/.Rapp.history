library(tidyverse)#
library(GenomicRanges)
d to granges function#
#
bed_to_granges <- function(file){#
   df = read.table(file, header=F, stringsAsFactors=F)#
   gr = with(df, GRanges(V1, IRanges(V2, V3), id=V4))   #
   return(gr)  #
}#
##get peaks#
#
mark = 'H3K27ac'#
cj.peaks = bed_to_granges(paste('peaks/cjTSC_CutTag_', mark, '.relaxed.bed', sep=''))#
hs.peaks = bed_to_granges(paste('peaks/hTSC_CutTag_', mark, '.relaxed.bed', sep=''))#
##shared families#
#
shared.fam = read_tsv('shared_families.txt', col_names=F)#
##get overlaps#
#
overlaps = tibble()#
#
for (ltr in shared.fam$X1) {#
	cj.shared = bed_to_granges(paste('LTR_orthology/', ltr, '_cjShared.bed', sep=''))#
	cj.spec = bed_to_granges(paste('LTR_orthology/', ltr, '_cjSpecific.bed', sep=''))#
	hs.shared = bed_to_granges(paste('LTR_orthology/', ltr, '_hsShared.bed', sep=''))#
	hs.spec = bed_to_granges(paste('LTR_orthology/', ltr, '_hsSpecific.bed', sep=''))#
	cj.shOv = subsetByOverlaps(cj.shared, cj.peaks, ignore.strand=T)#
	cj.spOv = subsetByOverlaps(cj.spec, cj.peaks, ignore.strand=T)#
	hs.shOv = subsetByOverlaps(hs.shared, cj.peaks, ignore.strand=T)#
	hs.spOv = subsetByOverlaps(hs.spec, cj.peaks, ignore.strand=T)#
	common = sum(hs.shOv$id %in% cj.shOv$id)#
	total = length(cj.shOv) + length(cj.spOv) + length(hs.shOv) + length(hs.spOv) - common#
	sub = tibble(ltr = rep(ltr, 5),#
				type = c('hs_specific', 'hs_active', 'shared', 'cj_active', 'cj_specific'),#
				n = c(length(hs.spOv),#
							length(hs.shOv)-common,#
							common,#
							length(cj.shOv)-common,#
							length(cj.spOv))) %>%#
			mutate(norm = n/total)#
	overlaps = rbind(overlaps, sub)#
}
