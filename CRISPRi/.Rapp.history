library(tidyverse)#
library(GenomicRanges)#
##process read counts from Seqmonk#
#
rpm = read_tsv('gene_raw_counts.txt') %>%#
	mutate(across(KRAB_01:IAP_gRNA_03, ~./sum(.)*1e6))#
#
ctrl = rowMeans(log2(rpm[,grep('KRAB',colnames(rpm))] + 0.05))#
iap = rowMeans(log2(rpm[,grep('IAP_gRNA',colnames(rpm))] + 0.05))#
#
rna = GRanges(seqnames=paste('chr',rpm$Chromosome,sep=''),#
		ranges=IRanges(start=rpm$Start, end=rpm$End),#
		strand=rpm$`Probe Strand`,#
		id=rpm$ID,#
		gene=rpm$Probe,#
		ctrl, iap)#
tss = promoters(rna)
nearestTE = function(tss.data, bed.file, breaks=c(0,1e4,5e4,1e5,1e9)) {#
	bed = read.delim(bed.file, header=F)#
	tes = GRanges(seqnames=bed$V1,#
			ranges=IRanges(start=bed$V2, end=bed$V3),#
			strand=bed$V6,#
			id=paste(bed$V4,bed$V1,bed$V2,sep='_'))#
	near = distanceToNearest(tss.data, tes, ignore.strand=TRUE)#
	tss.data$nearest = tss.data$distance = rep(NA,length(tss))#
	tss.data$nearest[near@from] = tes$id[near@to]#
	tss.data$distance[near@from] = elementMetadata(near)$distance#
	tss.data$dgroup = cut(tss.data$distance, breaks, include.lowest=T)#
	return(tss.data)#
}#
#
K4pos = nearestTE(tss, 'annotations/IAP_H3K4me3_GFPTSCs.bed')#
K4neg = nearestTE(tss, 'annotations/IAP_notH3K4me3_GFPTSCs.bed')#
#
ltr1 = nearestTE(tss, 'annotations/IAPLTR1_Mm.bed')#
other = nearestTE(tss, 'annotations/notIAPLTR1_Mm.bed')#
#
sgpos = nearestTE(tss, 'annotations/IAP_sgRNA_pos.bed')#
sgneg = nearestTE(tss, 'annotations/IAP_sgRNA_neg.bed')
K4pos = nearestTE(tss, 'IAP_subsets/IAP_H3K4me3_pos.bed')#
K4neg = nearestTE(tss, 'IAP_subsets/IAP_H3K4me3_neg.bed')#
#
ltr1 = nearestTE(tss, 'IAP_subsets/IAPLTR1_Mm.bed')#
other = nearestTE(tss, 'IAP_subsets/notIAPLTR1_Mm.bed')#
#
sgpos = nearestTE(tss, 'IAP_subsets/IAP_sgRNA_pos.bed')#
sgneg = nearestTE(tss, 'IAP_subsets/IAP_sgRNA_neg.bed')
min.expr = -1#
#
K4pos.df = filter(as.data.frame(K4pos), !is.na(distance), ctrl>min.expr | iap>min.expr)#
K4neg.df = filter(as.data.frame(K4neg), !is.na(distance), ctrl>min.expr | iap>min.expr)#
#
ltr1.df = filter(as.data.frame(ltr1), !is.na(distance), ctrl>min.expr | iap>min.expr)#
other.df = filter(as.data.frame(other), !is.na(distance), ctrl>min.expr | iap>min.expr)#
#
sgpos.df = filter(as.data.frame(sgpos), !is.na(distance), ctrl>min.expr | iap>min.expr)#
sgneg.df = filter(as.data.frame(sgneg), !is.na(distance), ctrl>min.expr | iap>min.expr)
plotFC = function(data) {#
	p = ggplot(data, aes(x=subset, y=iap-ctrl, fill=dgroup)) +#
		geom_boxplot(outlier.colour=NA) +#
		theme_classic() +#
		ylim(-2,2) +#
		scale_fill_manual(values=colorRampPalette(c('lightblue','darkblue'))(4)) +#
		geom_hline(yintercept=0, linetype='dashed') +#
		xlab('') +#
		ylab('Relative expression')#
	print(p)#
}
quartz(w=4.5, h=3)#
plotFC(rbind(add_column(K4pos.df, subset='H3K4me3+'), add_column(K4neg.df, subset='H3K4me3-')))
plotFC(rbind(add_column(ltr1.df, subset='IAPLTR1_Mm'), add_column(other.df, subset='Other IAPs')))
