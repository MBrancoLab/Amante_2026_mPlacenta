plotFC = function(df1, df2, name1, name2) {#
	data = rbind(select(df1, gene, ctrl, iap) %>% add_column(subset=name1),#
				select(df2, gene, ctrl, iap) %>% add_column(subset=name2))#
	p = ggplot(data, aes(x=subset, y=iap-ctrl)) +#
		geom_boxplot(outlier.colour=NA, fill='lightblue') +#
		theme_classic() +#
		ylim(-1.5,1.5) +#
		geom_hline(yintercept=0, linetype='dashed') +#
		xlab('') +#
		ylab('Log2 fold change')#
	print(p)#
	return(data)#
}#
#
quartz(w=2, h=3)#
ltr.data = plotFC(ltr1.df, other.df, 'IAPLTR1_Mm', 'Other IAPs')
ggsave('ltr1.svg')
sg.data = plotFC(sgpos.df, sgneg.df, 'sgRNA+', 'sgRNA-')
ggsave('sgrna.svg')
up = read.table('DEG_up.txt',row.names=1)
down = read.table('DEG_down.txt',row.names=1)
head(ltr.data)
group_by(ltr.data, subset) %>% summarise(all=length(gene))
group_by(ltr.data, subset) %>%#
	summarise(all=length(gene), up=sum(gene %in% rownames(up)))
group_by(ltr.data, subset) %>%#
	summarise(all=length(gene), up=sum(gene %in% rownames(up)), down=sum(gene %in% rownames(down)))
group_by(sg.data, subset) %>%#
	summarise(all=length(gene), up=sum(gene %in% rownames(up)), down=sum(gene %in% rownames(down)))
library('DESeq2')#
library('tidyverse')#
library('topGO')#
library('org.Mm.eg.db')#
##read raw counts#
counts = read.delim('gene_raw_counts.txt')#
reads = as.matrix(counts[,13:ncol(counts)])#
rownames(reads) = counts$Probe#
colData = DataFrame(sample=factor(rep(c('KRAB','IAP_gRNA'),each=3)))#
##get DE genes#
dds = DESeqDataSetFromMatrix(reads,colData,design=~sample)#
dds = DESeq(dds)#
res = results(dds,contrast=c('sample','IAP_gRNA','KRAB'))#
up = subset(res, padj<0.05 & log2FoldChange>1)#
down = subset(res, padj<0.05 & log2FoldChange<(-1))#
##Volcano plot#
#
quartz(w=5,h=3)#
mutate(as.data.frame(res), is.sig = padj<0.05 & abs(log2FoldChange)>1) %>%#
ggplot(aes(x=log2FoldChange, y=-log10(padj), colour=is.sig)) +#
	geom_point(size=0.5) +#
	theme_classic() +#
	scale_colour_manual(values=c('grey','red'))
quartz(w=3,h=3)#
mutate(as.data.frame(res), is.sig = padj<0.05 & abs(log2FoldChange)>1) %>%#
ggplot(aes(x=log2FoldChange, y=-log10(padj), colour=is.sig)) +#
	geom_point(size=0.5) +#
	theme_classic() +#
	scale_colour_manual(values=c('grey','blue'))
library(svglite)
ggsave('volcano.svg')
go.ann = function(de.genes) {#
	genes = factor(as.integer(rownames(reads) %in% rownames(de.genes)))#
	names(genes) = rownames(reads)#
	go = new('topGOdata', ontology = 'BP',#
		allGenes = genes, geneSelectionFun = function(x) x==0,#
		annotationFun = annFUN.org, mapping = 'org.Mm.eg.db', ID = 'SYMBOL')#
	return(go)#
}#
#
go.plot = function(go, nodes=8) {#
	rt = runTest(go, algorithm='classic', statistic='fisher')#
	gt = GenTable(go, classicFisher=rt, topNodes=nodes)#
#
	ggplot(gt, aes(x=-log10(as.numeric(classicFisher)), y=Term)) +#
		geom_bar(stat='identity', fill='grey', colour='black', width=0.7) +#
		theme_classic() +#
		ylab('') +#
		xlab('-log10 p')#
}#
#
go.up = go.ann(up)#
go.plot(go.up)
ggsave('upgo.svg')
go.down = go.ann(down)#
go.plot(go.down)
ggsave('downgo.svg')
